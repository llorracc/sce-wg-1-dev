# bst-natural-no-point-mass/1, the natural scenario without a point mass, as its stage file states it. The shocks' laws
# are bounded, with strictly positive lower and finite upper bounds, and no artificial constraint is stated. The worst
# income, ξ and ψ both at their floors, has probability zero, so an agent can end a period at the natural limit itself
# when ϱ < k, with k = 2 when both shocks have densities at their floors and k = 1 when one does; the Euler equation
# therefore carries its complementarity clause. The natural limit is −h_min, where h_min = ξ_min 𝒢ψ_min/(R − 𝒢ψ_min), the
# minimum present value of future income, is written out from the laws' bounds: Bellman-SYM has no derived parameters,
# and a separately calibrated limit is how a discretization's lowest atom gets in. ξ_min is the lower of ξ_u and the
# scaled employed floor. With p_zero = 0 the unemployment income is never paid, and the checker's calibration sets ξ_u to
# the employed floor, which leaves the model unchanged. The family requires 𝒢ψ_min < R. ϱ > 1. Survivors only.

@stage: natural_no_point_mass

Xm := ℝ
Xa := [-min(ξ_u, θ_min*(1 - p_zero*ξ_u)/(1 - p_zero))*𝒢*ψ_min/(R - 𝒢*ψ_min), inf)
Emp := {emp, unemp}   :: ["the unemployment event: employed; unemployed"]

β     : ℝ₊₊          :: ["discount factor of the type"]
ℒ     : (0,1]        :: ["probability of surviving into the next period, perpetual youth"]
ϱ     : (1, inf)     :: ["coefficient of relative risk aversion, greater than one as in Buffer Stock Theory"]
R     : ℝ₊₊          :: ["gross return on assets, earned by survivors, with no annuity market"]
𝒢     : ℝ₊₊          :: ["growth factor of permanent income"]
μ_ψ   : ℝ            :: ["location of log ψ before truncation, set so that E[ψ] = 1"]
s_ψ   : ℝ₊₊          :: ["scale of log ψ before truncation"]
ψ_min  : ℝ₊₊          :: ["the lower bound of ψ, strictly positive"]
ψ_max  : ℝ₊₊          :: ["the upper bound of ψ, finite"]
μ_θ   : ℝ            :: ["location of log θ before truncation, set so that E[θ] = 1"]
s_θ   : ℝ₊₊          :: ["scale of log θ before truncation"]
θ_min  : ℝ₊₊          :: ["the lower bound of θ, strictly positive"]
θ_max  : ℝ₊₊          :: ["the upper bound of θ, finite"]
p_zero : [0,1)       :: ["probability ℘ of unemployment"]
ξ_u   : ℝ₊           :: ["income ξ_u while unemployed, as a ratio to permanent income; requires p_zero*ξ_u < 1"]

ψ : ℝ₊₊
ψ ~ TruncatedLogNormal(μ_ψ, s_ψ, ψ_min, ψ_max)   :: ["permanent shock, E[ψ] = 1"]
θ : ℝ₊₊
θ ~ TruncatedLogNormal(μ_θ, s_θ, θ_min, θ_max)   :: ["employed transitory draw, E[θ] = 1; drawn but unused when unemployed"]
j : Emp
j ~ Bernoulli(p_zero)                          :: ["unemployment event: unemp with probability p_zero, independent of ψ and θ"]

𝑢(c : ℝ₊₊) := c^(1-ϱ)/(1-ϱ)       :: [id=util]
𝑑𝑢     := D_{c}(𝑢)                 :: [id=marg_util]
𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/ϱ)        :: [id=inv_marg_util]
𝒞(x : Xm) := (0, x + min(ξ_u, θ_min*(1 - p_zero*ξ_u)/(1 - p_zero))*𝒢*ψ_min/(R - 𝒢*ψ_min)]   :: [id=feasible]

[id=arvl_to_dcsn, (k : Xa, ψ, θ, j) : !arvl -> (m : Xm) : !dcsn] {
    ξ = (θ*(1 - p_zero*ξ_u)/(1 - p_zero), ξ_u)[j]   :: [id=transitory_income, "ξ = ξ_u when unemployed, else θ(1 - ℘ξ_u)/(1 - ℘), so E[ξ] = 1"]
    m = R*k/(𝒢*ψ) + ξ                                   :: [id=market_resources, "a survivor's resources; k is last period's a"]
}

[id=dcsn_to_cntn, (m, c : ℝ₊₊ @ !ctrl) : !dcsn -> (a : Xa) : !cntn] {
    a = m - c                         :: [id=savings]
}

[id=cntn_to_dcsn, (V[>] : ℝ @ !vlu, c) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V      = 𝑢(c) + β*ℒ*V[>]          :: [id=value]
    D_{m}V = 𝑑𝑢(c)                    :: [id=marginal]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<]      = E_{ψ,θ,j}((𝒢*ψ)^(1-ϱ) * V)             :: [id=value]
    D_{k}V[<] = E_{ψ,θ,j}(R * (𝒢*ψ)^(-ϱ) * D_{m}V)     :: [id=marginal]
}

[id=policy, (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊₊ @ !ctrl) : !dcsn] {
    c     = argmax_{cp : 𝒞(m)}(𝑢(cp) + β*ℒ*V[>])   :: [id=optimality, !doc]
    𝑑𝑢(c) = β*ℒ*D_{a}V[>] ⟂ m - c >= -min(ξ_u, θ_min*(1 - p_zero*ξ_u)/(1 - p_zero))*𝒢*ψ_min/(R - 𝒢*ψ_min)   :: [id=euler]
}
