# This branch holds the records only; main has its own list for the code and the website.

.DS_Store
__pycache__/
.pytest_cache/

# The worktrees of other branches, where this branch is checked out in the clone's own folder.
.worktrees/

# Backstop only. This repository is public and its history is permanent, so
# anything committed is published irreversibly. Confidential working notes are
# therefore kept outside this directory altogether rather than ignored inside
# it; this pattern and .githooks/pre-commit exist to catch a copy that lands
# here by accident, not to make the repository a place to keep one.
*.private.md
