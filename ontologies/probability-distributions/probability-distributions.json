    {
      "id": "PD_0000001",
      "kind": "measure",
      "name": "standard-normal",
      "label": "standard normal",
      "stated_set": "ℝ",
      "notation": "N(0, 1)",
      "density": "exp(-z**2/2)/sqrt(2*pi)",
      "support": {
        "lower": "-inf",
        "upper": "inf"
      },
      "definition": "The measure on ℝ with density φ(z) = exp(−z²/2)/√(2π) with respect to Lebesgue measure."
    },
    {
      "id": "PD_0000002",
      "kind": "operator",
      "name": "pushforward",
      "label": "pushforward",
      "arguments": [
        {
          "name": "map",
          "meaning": "a measurable map f from the measure's set"
        }
      ],
      "definition": "f∗μ(B) = μ(f⁻¹(B)), the law of f(X) when X has law μ."
    },
    {
      "id": "PD_0000003",
      "kind": "operator",
      "name": "conditioning",
      "label": "conditioning on a set",
      "arguments": [
        {
          "name": "set",
          "meaning": "a measurable set A with μ(A) > 0"
        }
      ],
      "definition": "μ|A(B) = μ(B ∩ A)/μ(A), the law of X given X ∈ A. Truncation is conditioning on an interval."
    },
    {
      "id": "PD_0000004",
      "kind": "operator",
      "name": "kernel-product",
      "label": "product with a kernel",
      "arguments": [
        {
          "name": "kernel",
          "meaning": "a Markov kernel κ from the measure's set to a set Y"
        }
      ],
      "definition": "(μ ⊗ κ)(A × B) = ∫_A κ(x, B) μ(dx), a measure on the product of the two sets: draw X from μ, then Y from κ(X, ·)."
    },
    {
      "id": "PD_0000005",
      "kind": "operator",
      "name": "affine-pushforward",
      "label": "affine map",
      "case_of": "PD_0000002",
      "arguments": [
        {
          "name": "location",
          "meaning": "a real number a"
        },
        {
          "name": "scale",
          "meaning": "a positive number b"
        }
      ],
      "map": "location + scale*z",
      "definition": "The pushforward under z ↦ a + b·z."
    },
    {
      "id": "PD_0000006",
      "kind": "operator",
      "name": "exponential-pushforward",
      "label": "exponential map",
      "case_of": "PD_0000002",
      "arguments": [],
      "map": "exp(z)",
      "definition": "The pushforward under z ↦ exp(z)."
    },
    {
      "id": "PD_0000007",
      "kind": "property",
      "name": "support",
      "label": "support",
      "definition": "The smallest closed set of full measure, recorded by its infimum and supremum, whether the infimum is attained, and the mass at the infimum."
    },
    {
      "id": "PD_0000008",
      "kind": "property",
      "name": "mean",
      "label": "mean",
      "definition": "E[X], where it is finite."
    },
    {
      "id": "PD_0000009",
      "kind": "property",
      "name": "moments",
