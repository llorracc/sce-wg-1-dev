    {
      "id": "PD_0000027",
      "kind": "family",
      "name": "truncated-normal",
      "label": "truncated normal",
      "stated_set": "[l, u] ∩ ℝ",
      "definition": "The law of μ + σZ given l ≤ μ + σZ ≤ u, Z standard normal.",
      "measure": "TruncatedNormal(μ, σ, l, u) = (aff(μ, σ)∗ N(0, 1))|[l, u]",
      "built_from": {
        "base": "PD_0000001",
        "operators": [
          {
            "operator": "PD_0000005",
            "arguments": {
              "location": "mu",
              "scale": "sigma"
            }
          },
          {
            "operator": "PD_0000026",
            "arguments": {
              "lower": "l",
              "upper": "u"
            }
          }
        ]
      },
      "where": {
        "a": "(l - mu)/sigma",
        "b": "(u - mu)/sigma",
        "D": "Phi(b) - Phi(a)"
      },
      "canonical_chart": "PD_0000028",
      "charts": [
        "PD_0000028"
      ],
      "properties": {
        "support": {
          "infimum": "l",
          "supremum": "u",
          "mass_at_infimum": "0"
        },
        "mean": "mu + sigma*(phi(a) - phi(b))/D",
        "moments": {
          "orders": "nonnegative-integers"
        }
      },
      "reductions": [
        {
          "when": "l == -inf and u == inf",
          "family": "PD_0000013",
          "chart": "PD_0000014"
        }
      ]
    },
