pd:PD_0000001
    a owl:NamedIndividual, pd:Measure ;
    rdfs:label "standard normal"@en ;
    skos:notation "standard-normal" ;
    skos:definition "The measure on ℝ with density φ(z) = exp(−z²/2)/√(2π) with respect to Lebesgue measure."@en ;
    pd:statedSet "ℝ" ;
    pd:notation "N(0, 1)" .

pd:PD_0000002
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "pushforward"@en ;
    skos:notation "pushforward" ;
    skos:definition "f∗μ(B) = μ(f⁻¹(B)), the law of f(X) when X has law μ."@en ;
    pd:argument [ pd:position 1 ; pd:name "map" ; pd:meaning "a measurable map f from the measure's set"@en ] .

pd:PD_0000003
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "conditioning on a set"@en ;
    skos:notation "conditioning" ;
    skos:definition "μ|A(B) = μ(B ∩ A)/μ(A), the law of X given X ∈ A. Truncation is conditioning on an interval."@en ;
    pd:argument [ pd:position 1 ; pd:name "set" ; pd:meaning "a measurable set A with μ(A) > 0"@en ] .

pd:PD_0000004
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "product with a kernel"@en ;
    skos:notation "kernel-product" ;
    skos:definition "(μ ⊗ κ)(A × B) = ∫_A κ(x, B) μ(dx), a measure on the product of the two sets: draw X from μ, then Y from κ(X, ·)."@en ;
    pd:argument [ pd:position 1 ; pd:name "kernel" ; pd:meaning "a Markov kernel κ from the measure's set to a set Y"@en ] .

pd:PD_0000005
    a owl:NamedIndividual, pd:Operator ;
