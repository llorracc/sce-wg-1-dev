    pd:argument [ pd:position 1 ; pd:name "location" ; pd:meaning "a real number a"@en ] ;
    pd:argument [ pd:position 2 ; pd:name "scale" ; pd:meaning "a positive number b"@en ] ;
    pd:map "location + scale*z" .

pd:PD_0000006
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "exponential map"@en ;
    skos:notation "exponential-pushforward" ;
    skos:definition "The pushforward under z ↦ exp(z)."@en ;
