bsm:BSM_0000001
    a owl:Class ;
    rdfs:subClassOf bsm:Model ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model"@en ;
    skos:notation "buffer-stock-model" ;
    skos:definition "A consumption-saving problem of one agent, with CRRA utility and relative risk aversion above one, assets that earn a return, and risky noncapital income that is permanent income times a transitory shock, permanent income growing by a factor and a mean-one permanent shock; borrowing limited by the natural constraint or a tighter artificial one; and, where the natural constraint is the one in force, an atom at the lowest transitory shock. Whether a member exhibits buffer-stock saving is a property of its solution, not of its membership."@en ;
    bsm:hasAxiom bsm:BSM_0000010 ;
    bsm:hasAxiom bsm:BSM_0000011 ;
    bsm:hasAxiom bsm:BSM_0000012 ;
    bsm:hasAxiom bsm:BSM_0000148 ;
    bsm:hasAxiom bsm:BSM_0000013 ;
    bsm:hasAxiom bsm:BSM_0000014 ;
    bsm:hasAxiom bsm:BSM_0000015 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000002
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "Buffer Stock Theory's model, as the paper states it"@en ;
    skos:notation "bst-model" ;
    skos:definition "The buffer-stock models whose shocks are iid with bounded support, whose transitory shock has a zero-income event of positive probability, with no artificial constraint, infinite lives and one type: the class to which the paper's theorems apply."@en ;
    bsm:hasAxiom bsm:BSM_0000016 ;
    bsm:hasAxiom bsm:BSM_0000017 ;
    bsm:hasAxiom bsm:BSM_0000018 ;
    bsm:hasAxiom bsm:BSM_0000149 ;
    bsm:hasAxiom bsm:BSM_0000019 ;
    bsm:hasAxiom bsm:BSM_0000020 ;
    bsm:hasAxiom bsm:BSM_0000021 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#bounded-support> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000003
    a owl:Class ;
    rdfs:subClassOf bsm:Model ;
    a bsm:ModelClass ;
    rdfs:label "the perfect-foresight benchmark"@en ;
    skos:notation "perfect-foresight-benchmark" ;
    skos:definition "The models with no shocks: ψ = θ = 1 and no unemployment. They fail the axiom of income risk and so are not buffer-stock models; they are the class's limit as the shocks vanish, and the paper's benchmark for the patience conditions."@en ;
    bsm:benchmarkOf bsm:BSM_0000001 ;
    bsm:hasAxiom bsm:BSM_0000022 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-pfbbenchmark> .

bsm:BSM_0000004
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with perpetual youth"@en ;
    skos:notation "with-survival" ;
    skos:definition "A buffer-stock model in which an agent survives each period with probability ℒ ≤ 1 and is replaced at death by a newborn; there is no annuity, so survivors earn R and the assets of the dead leave the economy: the paper's Modigliani scheme of estates."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "L == 1" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#modigliani-lives> .

bsm:BSM_0000005
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with Blanchard's annuities"@en ;
    skos:notation "with-blanchard-annuities" ;
    skos:definition "A buffer-stock model with perpetual youth in which the estates of the dead are paid to survivors in proportion to their wealth, so that survivors earn R/ℒ and the absolute patience factor is the same as with infinite lives."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "L == 1" ;
    bsm:inHARK "AggShockConsumerType" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsAggShockModel.py#L269> .

bsm:BSM_0000006
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a positive unemployment benefit"@en ;
    skos:notation "with-positive-benefit" ;
    skos:definition "A buffer-stock model whose unemployment event pays ξ_u > 0 of permanent income in place of BST's zero-income event."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "xi_u == 0" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000007
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with an artificial borrowing constraint"@en ;
    skos:notation "with-artificial-constraint" ;
    skos:definition "A buffer-stock model with an artificial borrowing constraint a_Art strictly above the natural one. A constraint no tighter than the natural one has no effect, and describes the model without it."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "a_Art <= a_Nat" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-liqconstraslimit> .

bsm:BSM_0000008
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock population of permanent types"@en ;
    skos:notation "with-types" ;
    skos:definition "A population of K permanent types with shares ω_i, each a buffer-stock model differing from the others in its discount factor β_i alone. The types are solved separately; the population is their mixture."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "K == 1" ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L48> .

bsm:BSM_0000009
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with Markov employment and an aggregate regime"@en ;
    skos:notation "with-markov-states" ;
    skos:definition "A buffer-stock model whose transitory income depends on a Markov employment state, with benefits that expire, and on an aggregate regime that is itself a Markov state; HAFiscal's household. The paper remarks that persistent but mean-reverting transitory shocks would change none of its key results; the conditions become conditions on matrices over the states."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "the chain has one state" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L124> .

bsm:BSM_0000145
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a higher rate on borrowing"@en ;
    skos:notation "with-kinked-return" ;
    skos:definition "A buffer-stock model in which negative assets pay a return factor above the one positive assets earn; HARK's KinkedRconsumerType."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "R_boro == R" ;
    bsm:inHARK "KinkedRconsumerType" .

bsm:BSM_0000146
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a risky asset"@en ;
    skos:notation "with-risky-asset" ;
    skos:definition "A buffer-stock model in which assets, or a share of them the agent chooses, earn a random return. The owner ruled on 2026-10-27 that such a model has a target; its conditions are not yet stated, and this ontology states none."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "the return is riskless" ;
    bsm:inHARK "PortfolioConsumerType" .

bsm:BSM_0000147
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "life-cycle buffer-stock model"@en ;
    skos:notation "life-cycle" ;
    skos:definition "A buffer-stock model with a finite horizon whose primitives may vary with age. A primitive indexed by period t governs the move from t to t+1: the income laws, the survival probability, the return on end-of-period assets and the growth factor of permanent income, as HARK's solvers read them. The paper's limiting solution is the limit of such problems with constant primitives as the horizon recedes."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "constant primitives, in the limit of an infinite horizon" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-theory> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L650-L662> .

bsm:BSM_0000010
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "one agent's consumption-saving problem"@en ;
    skos:notation "one-agent-saving" ;
    skos:definition "Each period one agent splits market resources m between consumption c > 0 and end-of-period assets a = m − c, maximizing expected discounted utility; resources next period are R a/(𝒢ψ′) + ξ′ in ratios to permanent income."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-levelrecproblem> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000011
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "CRRA utility with relative risk aversion above one"@en ;
    skos:notation "crra-above-one" ;
    skos:definition "u(c) = c^(1−ϱ)/(1−ϱ) with ϱ > 1, so that u(0⁺) = −∞."@en ;
    bsm:check "rho > 1" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000012
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the Friedman–Muth income process"@en ;
    skos:notation "friedman-muth-income" ;
    skos:definition "Noncapital income is 𝐩 ξ, with permanent income 𝐩′ = 𝒢 ψ′ 𝐩; the permanent shock ψ is positive with E[ψ] = 1, and the transitory shock ξ is nonnegative with a finite positive mean."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000013
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "assets earn a return"@en ;
    skos:notation "asset-return" ;
    skos:definition "End-of-period assets earn a gross return factor R > 0 into next period. In the paper's model it is riskless and constant; a risky return or a higher rate on borrowing makes an extension."@en ;
    bsm:check "R > 0" ;
    bsm:tier "membership" ;
    bsm:status "proposed" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000014
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the borrowing constraint in force"@en ;
    skos:notation "constraint-in-force" ;
    skos:definition "End-of-period assets satisfy a ≥ a_min = max(a_Art, a_Nat): the natural constraint, which u(0⁺) = −∞ and the worst income impose, or a tighter artificial one."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000015
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "an atom at the worst transitory shock where the natural constraint is in force"@en ;
    skos:notation "point-mass-at-worst-transitory" ;
    skos:definition "Where the natural constraint is as tight as or tighter than every artificial constraint (a_min = a_Nat, the edge a_Art = a_Nat included), the lowest value of the transitory shock carries positive probability under the true law: P(ξ = inf supp ξ) > 0. The condition is on the transitory shock alone, not on income ψξ. The paper calls such an atom inessential to its proofs; the owner's ruling makes it part of the class's definition."@en ;
    bsm:check "a_min > a_Nat or xi_atom > 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-10-31"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000001 ;
    bsm:dependsOn bsm:BSM_0000057 ;
    bsm:dependsOn bsm:BSM_0000058 ;
    bsm:dependsOn bsm:BSM_0000048 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000016
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "iid shocks"@en ;
    skos:notation "iid-shocks" ;
    skos:definition "ψ and ξ are independent of each other and over time, and identically distributed."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000017
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "bounded support"@en ;
    skos:notation "bounded-support" ;
    skos:definition "ψ ∈ [ψ_min, ψ_max] with 0 < ψ_min ≤ 1 ≤ ψ_max < ∞, and the employed draw θ ∈ [θ_min, θ_max] with 0 < θ_min ≤ 1 ≤ θ_max < ∞. This excludes the untruncated lognormal, and admits every discretization of it."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#bounded-support> .

bsm:BSM_0000018
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the zero-income event"@en ;
    skos:notation "zero-income-event" ;
    skos:definition "ξ = 0 with probability ℘ > 0, and ξ = θ/(1 − ℘) otherwise, with E[θ] = 1."@en ;
    bsm:check "wp > 0 and xi_u == 0" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    bsm:dependsOn bsm:BSM_0000043 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000019
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no artificial constraint"@en ;
    skos:notation "no-artificial-constraint" ;
    skos:definition "There is no artificial borrowing constraint; the natural constraint is the one in force."@en ;
    bsm:check "a_min == a_Nat" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000057 ;
    bsm:dependsOn bsm:BSM_0000058 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> .

bsm:BSM_0000020
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "infinite lives"@en ;
    skos:notation "infinite-lives" ;
    skos:definition "ℒ = 1; the object of study is the limit of the finite-horizon solutions as the horizon recedes."@en ;
    bsm:check "L == 1" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000021
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "one type"@en ;
    skos:notation "one-type" ;
    skos:definition "Every agent has the same primitives."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000022
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no shocks"@en ;
    skos:notation "no-shocks" ;
    skos:definition "℘ = 0 and ψ = θ = 1 with probability one."@en ;
    bsm:check "wp == 0" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000003 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> .

bsm:BSM_0000148
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "income risk"@en ;
    skos:notation "income-risk" ;
    skos:definition "At least one of the permanent and the transitory shock is not degenerate. A model without income risk has no precautionary motive and is the perfect-foresight benchmark, not a buffer-stock model."@en ;
    bsm:tier "membership" ;
    bsm:status "proposed" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> .

bsm:BSM_0000149
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "a riskless, constant return"@en ;
    skos:notation "riskless-constant-return" ;
    skos:definition "The return factor R is known and the same in every period, for positive and negative assets alike."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000023
    a owl:NamedIndividual, bsm:Agent ;
    rdfs:label "agent"@en ;
    skos:notation "agent" ;
    skos:definition "The consumer whose problem the model states."@en ;
    bsm:category "agent" .

bsm:BSM_0000024
    a owl:NamedIndividual, bsm:Population ;
    rdfs:label "population"@en ;
    skos:notation "population" ;
    skos:definition "A continuum of agents of unit mass, each following the model's rule."@en ;
    bsm:category "population" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#the-aggregate-and-idiosyncratic-relationship-between-consumption-growth-and-income-growth> .

bsm:BSM_0000025
    a owl:NamedIndividual, bsm:Time ;
    rdfs:label "period"@en ;
    skos:notation "period" ;
    skos:definition "The time index t; finite-horizon problems run to a terminal period T."@en ;
    bsm:category "time" ;
    bsm:registryKey "period-now" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000026
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "market resources"@en ;
    skos:notation "market-resources" ;
    skos:definition "Bank balances plus noncapital income, as a ratio to permanent income; the state of the normalized problem."@en ;
    bsm:symbol "m" ;
    bsm:category "state" ;
    bsm:inBST "\\mNrm" ;
    bsm:registryKey "resources-now" ;
    bsm:inBellmanSym "m" ;
    bsm:inHARK "mNrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-ratio> .

bsm:BSM_0000027
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "permanent income"@en ;
    skos:notation "permanent-income" ;
    skos:definition "The level 𝐩 by which the problem is normalized; 𝐩′ = 𝒢 ψ′ 𝐩."@en ;
    bsm:category "state" ;
    bsm:inBST "\\pLvl" ;
    bsm:inHARK "pLvl" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000028
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "kapital"@en ;
    skos:notation "kapital" ;
    skos:definition "Beginning-of-period capital, last period's end-of-period assets."@en ;
    bsm:category "state" ;
    bsm:registryKey "kapital-now" ;
    bsm:inBellmanSym "k" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000029
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "bank balances"@en ;
    skos:notation "bank-balances" ;
    skos:definition "b = R k/(𝒢 ψ), kapital with its return, as a ratio to this period's permanent income."@en ;
    bsm:category "state" ;
    bsm:inBST "\\bNrm" ;
    bsm:registryKey "bank-balances" ;
    bsm:inHARK "bNrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000030
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "end-of-period assets"@en ;
    skos:notation "end-of-period-assets" ;
    skos:definition "a = m − c, as a ratio to permanent income."@en ;
    bsm:category "state" ;
    bsm:registryKey "assets-now" ;
    bsm:inBellmanSym "a" ;
    bsm:inHARK "aNrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000031
    a owl:NamedIndividual, bsm:Control ;
    rdfs:label "consumption"@en ;
    skos:notation "consumption" ;
    skos:definition "c, as a ratio to permanent income; the agent's one choice."@en ;
    bsm:category "control" ;
    bsm:registryKey "consumption-now" ;
    bsm:inBellmanSym "c" ;
    bsm:inHARK "cNrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000032
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "permanent shock"@en ;
    skos:notation "permanent-shock" ;
    skos:definition "ψ, the mean-one shock to permanent income; its law is a mean-one law of the ontology of probability distributions."@en ;
    bsm:category "shock" ;
    bsm:lawIn pd:PD_0000012 ;
    bsm:lawIn pd:PD_0000018 ;
    bsm:lawIn pd:PD_0000031 ;
    bsm:inBST "\\permShk" ;
    bsm:registryKey "permanent-shock" ;
    bsm:inParameterFile "income.permanent_shock" ;
    bsm:inBellmanSym "ψ" ;
    bsm:inHARK "PermShk" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000033
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "transitory shock"@en ;
    skos:notation "transitory-shock" ;
    skos:definition "ξ, transitory income as a ratio to permanent income, the unemployment event included: ξ_u with probability ℘, else the scaled employed draw."@en ;
    bsm:category "shock" ;
    bsm:inBST "\\tranShkAll" ;
    bsm:registryKey "transitory-shock-all" ;
    bsm:inBellmanSym "ξ" ;
    bsm:inHARK "TranShk" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000034
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "employed transitory draw"@en ;
    skos:notation "transitory-shock-employed" ;
    skos:definition "θ, the mean-one draw of transitory income while employed."@en ;
    bsm:category "shock" ;
    bsm:lawIn pd:PD_0000012 ;
    bsm:lawIn pd:PD_0000018 ;
    bsm:lawIn pd:PD_0000031 ;
    bsm:inBST "\\tranShkEmp" ;
    bsm:registryKey "transitory-shock-employed" ;
    bsm:inParameterFile "income.employed_shock" ;
    bsm:inBellmanSym "θ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000035
    a owl:NamedIndividual, bsm:Event ;
    rdfs:label "unemployment event"@en ;
    skos:notation "unemployment-event" ;
    skos:definition "The event in which transitory income is ξ_u; BST's zero-income event when ξ_u = 0."@en ;
    bsm:category "event" ;
    bsm:inBellmanSym "j" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000036
    a owl:NamedIndividual, bsm:Event ;
    rdfs:label "survival event"@en ;
    skos:notation "survival-event" ;
    skos:definition "The event, of probability ℒ, that an agent alive this period is alive the next."@en ;
    bsm:category "event" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000037
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "relative risk aversion"@en ;
    skos:notation "crra" ;
    skos:definition "ϱ, the coefficient of relative risk aversion of the CRRA utility function."@en ;
    bsm:symbol "rho" ;
    bsm:category "primitive" ;
    bsm:inBST "\\CRRA" ;
    bsm:registryKey "crra" ;
    bsm:inParameterFile "crra" ;
    bsm:inBellmanSym "ϱ" ;
    bsm:inHARK "CRRA" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000038
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "discount factor"@en ;
    skos:notation "discount-factor" ;
    skos:definition "β, the pure time-preference factor of one type."@en ;
    bsm:symbol "beta" ;
    bsm:category "primitive" ;
    bsm:inBST "\\DiscFac" ;
    bsm:registryKey "discount-factor" ;
    bsm:inParameterFile "types[].beta" ;
    bsm:inBellmanSym "β" ;
    bsm:inHARK "DiscFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000039
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "survival probability"@en ;
    skos:notation "survival-prob" ;
    skos:definition "ℒ, the probability of surviving into the next period."@en ;
    bsm:symbol "L" ;
    bsm:category "primitive" ;
    bsm:inBST "\\Alive" ;
    bsm:registryKey "survival-prob" ;
    bsm:inParameterFile "survival" ;
    bsm:inBellmanSym "ℒ" ;
    bsm:inHARK "LivPrb" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000040
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "return factor"@en ;
    skos:notation "return-factor" ;
    skos:definition "R, the gross return on the riskless asset."@en ;
    bsm:symbol "R" ;
    bsm:category "primitive" ;
    bsm:inBST "\\Rfree" ;
    bsm:registryKey "return-factor" ;
    bsm:inParameterFile "return" ;
    bsm:inBellmanSym "R" ;
    bsm:inHARK "Rfree" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000041
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "growth factor of permanent income"@en ;
    skos:notation "growth-factor" ;
    skos:definition "𝒢, the expected growth factor of permanent income."@en ;
    bsm:symbol "G" ;
    bsm:category "primitive" ;
    bsm:inBST "\\PermGroFac" ;
    bsm:registryKey "growth-factor" ;
    bsm:inParameterFile "income.growth" ;
    bsm:inBellmanSym "𝒢" ;
    bsm:inHARK "PermGroFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000042
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "probability of unemployment"@en ;
    skos:notation "unemployment-prob" ;
    skos:definition "℘, the probability of the unemployment event, whatever ξ_u is."@en ;
    bsm:symbol "wp" ;
    bsm:category "primitive" ;
    bsm:inBST "\\pZero" ;
    bsm:registryKey "unemployment-prob" ;
    bsm:inParameterFile "income.unemployment.prob" ;
    bsm:inBellmanSym "p_zero" ;
    bsm:inHARK "UnempPrb" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000043
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "income while unemployed"@en ;
    skos:notation "income-unemployed" ;
    skos:definition "ξ_u ≥ 0, transitory income in the unemployment event, as a ratio to permanent income."@en ;
    bsm:symbol "xi_u" ;
    bsm:category "primitive" ;
    bsm:inBST "\\IncUnemp" ;
    bsm:registryKey "income-unemployed" ;
    bsm:inParameterFile "income.unemployment.income" ;
    bsm:inBellmanSym "ξ_u" ;
    bsm:inHARK "IncUnemp" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000044
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "artificial borrowing constraint"@en ;
    skos:notation "borrowing-limit-artificial" ;
    skos:definition "a_Art ≤ 0, a lower bound on end-of-period assets imposed from outside the household's problem."@en ;
    bsm:symbol "a_Art" ;
    bsm:category "primitive" ;
    bsm:inBST "\\BoroCnstArt" ;
    bsm:registryKey "borrowing-limit-artificial" ;
    bsm:inParameterFile "borrowing_constraint" ;
    bsm:inBellmanSym "a_Art" ;
    bsm:inHARK "BoroCnstArt" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000150
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "return factor on borrowing"@en ;
    skos:notation "return-borrowing" ;
    skos:definition "The gross return factor negative assets pay, in the extension with a higher rate on borrowing."@en ;
    bsm:symbol "R_boro" ;
    bsm:category "primitive" ;
    bsm:registryKey "return-borrowing" ;
    bsm:inHARK "Rboro" .

bsm:BSM_0000045
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "share of a type"@en ;
    skos:notation "type-share" ;
    skos:definition "ω_i, the share of type i in the population."@en ;
    bsm:category "primitive" ;
    bsm:registryKey "weight" ;
    bsm:inParameterFile "types[].share" .

bsm:BSM_0000046
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "lowest permanent shock"@en ;
    skos:notation "permanent-shock-min" ;
    skos:definition "ψ_min, the infimum of the permanent shock's support under the true law; zero for a law unbounded below."@en ;
    bsm:symbol "psi_min" ;
    bsm:category "bound" ;
    bsm:inBST "\\permShkIndMin" ;
    bsm:registryKey "permanent-shock-min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000047
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "lowest transitory shock"@en ;
    skos:notation "transitory-shock-min" ;
    skos:definition "ξ_min, the infimum of the transitory shock's support under the true law: the lower of ξ_u (when ℘ > 0) and the lowest scaled employed draw."@en ;
    bsm:symbol "xi_min" ;
    bsm:category "bound" ;
    bsm:inBST "\\tranShkMin" ;
    bsm:registryKey "transitory-shock-min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000048
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "probability of the lowest transitory shock"@en ;
    skos:notation "transitory-atom-prob" ;
    skos:definition "P(ξ = ξ_min), the mass the true law of the transitory shock puts at its infimum."@en ;
    bsm:symbol "xi_atom" ;
    bsm:category "bound" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000049
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "probability of the worst income"@en ;
    skos:notation "worst-income-prob" ;
    skos:definition "The probability that income ψξ takes its lowest value: ℘ when the unemployment event pays nothing, otherwise the product of the two laws' masses at their infima."@en ;
    bsm:symbol "p_worst" ;
    bsm:category "bound" ;
    bsm:registryKey "worst-income-prob" ;
    bsm:inHARK "WorstIncPrb" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000050
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "utility function"@en ;
    skos:notation "utility-function" ;
    skos:definition "u(c) = c^(1−ϱ)/(1−ϱ)."@en ;
    bsm:category "function" ;
    bsm:inBST "\\uFunc" ;
    bsm:registryKey "utility-function" ;
    bsm:inBellmanSym "𝑢" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000051
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "value function"@en ;
    skos:notation "value-function" ;
    skos:definition "v_t(m), the normalized value of the finite-horizon problem, value in levels divided by 𝐩^(1−ϱ); its limit as the horizon recedes is the limiting value function v."@en ;
    bsm:category "function" ;
    bsm:inBST "\\vFunc" ;
    bsm:inBellmanSym "V" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000052
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "consumption function"@en ;
    skos:notation "consumption-function" ;
    skos:definition "c_t(m), the optimal consumption of the finite-horizon problem; its limit as the horizon recedes is the limiting consumption function c, the rule a population follows."@en ;
    bsm:category "function" ;
    bsm:inBST "\\cFunc" ;
    bsm:registryKey "consumption-function" ;
    bsm:inHARK "cFunc" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-cfunceq1> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000053
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "stationary Bellman operator"@en ;
    skos:notation "bellman-operator" ;
    skos:definition "T, the map from next period's normalized value function to this period's, over consumption in (0, m)."@en ;
    bsm:category "operator" ;
    bsm:inBST "\\TMap" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#stationary-bellman-operator> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-maintmap> .

bsm:BSM_0000054
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "Euler equation"@en ;
    skos:notation "euler-equation" ;
    skos:definition "u′(c_t) = R β E_t[(𝒢ψ′)^(−ϱ) u′(c_{t+1})] in the normalized problem, with survival β̊ in place of β; with a binding artificial constraint, an inequality with complementary slackness."@en ;
    bsm:category "operator" ;
    bsm:inBellmanSym "policy.euler" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-scaledeuler> .

bsm:BSM_0000055
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "expectation over beliefs"@en ;
    skos:notation "expectation" ;
    skos:definition "E_t, the expectation over next period's shocks, for one agent's beliefs."@en ;
    bsm:category "operator" ;
    bsm:inBST "\\Ex" ;
    bsm:registryKey "expectation" ;
    bsm:inBellmanSym "E_{ψ,θ,j}" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-levelrecproblem> .

bsm:BSM_0000056
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "cross-sectional mean"@en ;
    skos:notation "cross-sectional-mean" ;
    skos:definition "𝕄, the mean of a variable across the population's empirical distribution, as distinct from the expectation over one agent's beliefs."@en ;
    bsm:category "operator" ;
    bsm:inBST "\\Mean" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-cgroeqpermgrofacq> .

bsm:BSM_0000057
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "natural borrowing constraint"@en ;
    skos:notation "borrowing-limit-natural" ;
    skos:definition "a_Nat, the lowest end-of-period assets from which the worst income next period still allows positive consumption forever: minus the present value of the worst income, capitalized at ℛ."@en ;
    bsm:symbol "a_Nat" ;
    bsm:category "constraint" ;
    bsm:inBST "\\BoroCnstNat" ;
    bsm:registryKey "borrowing-limit-natural" ;
    bsm:inBellmanSym "a_Nat" ;
    bsm:inHARK "BoroCnstNat" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000058
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "constraint in force"@en ;
    skos:notation "borrowing-limit" ;
    skos:definition "a_min = max(a_Art, a_Nat), the borrowing constraint the agent faces."@en ;
    bsm:symbol "a_min" ;
    bsm:category "constraint" ;
    bsm:registryKey "borrowing-limit" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000059
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "dynamic budget constraint"@en ;
    skos:notation "dynamic-budget-constraint" ;
    skos:definition "a = m − c; k′ = a; 𝐩′ = 𝒢ψ′𝐩; m′ = R k′/(𝒢ψ′) + ξ′."@en ;
    bsm:category "constraint" ;
    bsm:inBellmanSym "arvl_to_dcsn.market_resources" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000060
    a owl:NamedIndividual, bsm:Measure ;
    rdfs:label "population measure"@en ;
    skos:notation "population-measure" ;
    skos:definition "The measure that gives each agent of the population weight one."@en ;
    bsm:category "measure" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000061
    a owl:NamedIndividual, bsm:Measure ;
    rdfs:label "income measure"@en ;
    skos:notation "income-measure" ;
    skos:definition "The measure that weights each agent by its permanent income, normalized to total weight one: Harmenberg's permanent-income-neutral measure."@en ;
    bsm:category "measure" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-harmcdf> .

bsm:BSM_0000062
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ⁻¹]"@en ;
    skos:notation "e-psi-inv" ;
    bsm:symbol "E_psi_inv" ;
    bsm:formula "E(X**-1)" ;
    bsm:momentOf bsm:BSM_0000032 ;
    bsm:inBST "\\EPermShkInv" ;
    bsm:registryKey "e-perm-shk-inv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacmod> .

bsm:BSM_0000063
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ^(1−ϱ)]"@en ;
    skos:notation "e-psi-pow-1-minus-rho" ;
    bsm:symbol "E_psi_1mrho" ;
    bsm:formula "E(X**(1 - rho))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000064
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[log ψ]"@en ;
    skos:notation "e-log-psi" ;
    bsm:symbol "E_log_psi" ;
    bsm:formula "E(log(X))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000065
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ log ψ]"@en ;
    skos:notation "e-psi-log-psi" ;
    bsm:symbol "E_psi_log_psi" ;
    bsm:formula "E(X*log(X))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> .

bsm:BSM_0000066
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "discount factor with survival"@en ;
    skos:notation "discount-factor-liv" ;
    skos:definition "β̊ = β ℒ, the factor by which the household discounts next period's value when there is no annuity."@en ;
    bsm:symbol "beta_eff" ;
    bsm:formula "beta*L" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:registryKey "discount-factor-liv" ;
    bsm:inHARK "DiscFacEff" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000067
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "absolute patience factor"@en ;
    skos:notation "patience-abs" ;
    skos:definition "Þ = (R β)^(1/ϱ), the growth factor of consumption under perfect foresight with infinite lives."@en ;
    bsm:symbol "thorn_raw" ;
    bsm:formula "(R*beta)**(1/rho)" ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:inBST "\\APFac" ;
    bsm:registryKey "patience-abs" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#apfac> .

bsm:BSM_0000068
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "absolute patience factor with survival"@en ;
    skos:notation "patience-abs-liv" ;
    skos:definition "Þ̊ = (R β̊)^(1/ϱ), the absolute patience factor with survival and no annuity; Þ when ℒ = 1."@en ;
    bsm:symbol "thorn" ;
    bsm:formula "(R*beta*L)**(1/rho)" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:registryKey "patience-abs-liv" ;
    bsm:inHARK "APFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#apfac> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000069
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "return patience factor"@en ;
    skos:notation "patience-return-liv" ;
    skos:definition "Þ̊_R = Þ̊/R."@en ;
    bsm:symbol "thorn_R" ;
    bsm:formula "thorn/R" ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    bsm:inBST "\\RPFac" ;
    bsm:registryKey "patience-return-liv" ;
    bsm:inHARK "RPFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ric> .

bsm:BSM_0000070
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "growth patience factor"@en ;
    skos:notation "patience-growth-liv" ;
    skos:definition "Þ̊_𝒢 = Þ̊/𝒢."@en ;
    bsm:symbol "thorn_G" ;
    bsm:formula "thorn/G" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    bsm:inBST "\\GPFacRaw" ;
    bsm:registryKey "patience-growth-liv" ;
    bsm:inHARK "GPFacRaw" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacraw> .

bsm:BSM_0000071
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "risk-modified growth patience factor"@en ;
    skos:notation "patience-growth-mod" ;
    skos:definition "Þ̊_𝒢 E[ψ⁻¹], the expectation of the ratio of the absolute patience factor to the stochastic growth factor."@en ;
    bsm:symbol "thorn_G_mod" ;
    bsm:formula "thorn_G*E_psi_inv" ;
    bsm:dependsOn bsm:BSM_0000062 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:inBST "\\GPFacMod" ;
    bsm:registryKey "patience-growth-mod" ;
    bsm:inHARK "GPFacMod" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacmod> .

bsm:BSM_0000072
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "mortality-adjusted growth patience factor"@en ;
    skos:notation "patience-growth-mortality-adj" ;
    skos:definition "ℒ Þ̊_𝒢, the growth patience factor of a cohort whose members die at rate 1 − ℒ."@en ;
    bsm:symbol "thorn_G_liv" ;
    bsm:formula "L*thorn_G" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:registryKey "patience-growth-mortality-adj" ;
    bsm:inHARK "GPFacLiv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000073
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "return factor normalized by growth"@en ;
    skos:notation "return-growth-ratio" ;
    skos:definition "ℛ = R/𝒢."@en ;
    bsm:symbol "R_by_G" ;
    bsm:formula "R/G" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:inBST "\\RNrmByG" ;
    bsm:registryKey "return-growth-ratio" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000074
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "finite human wealth factor"@en ;
    skos:notation "human-wealth-factor" ;
    skos:definition "𝒢/R, the factor by which the present value of noncapital income is discounted each period."@en ;
    bsm:symbol "fhw" ;
    bsm:formula "G/R" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:inHARK "FHWFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-fhwc> .

bsm:BSM_0000075
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "human wealth"@en ;
    skos:notation "human-wealth" ;
    skos:definition "h, the present value of noncapital income as a ratio to permanent income, including this period's, in the limit of an infinite horizon; finite exactly when the FHWC holds."@en ;
    bsm:symbol "h" ;
    bsm:formula "1/(1 - G/R)" ;
    bsm:domain bsm:BSM_0000085 ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:inBST "\\hNrm" ;
    bsm:registryKey "human-wealth" ;
    bsm:inHARK "hNrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-hdef> .

bsm:BSM_0000076
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "perfect-foresight value-of-autarky factor"@en ;
    skos:notation "pf-value-of-autarky-factor" ;
    skos:definition "β̊ 𝒢^(1−ϱ), the factor of the value of consuming permanent income forever under perfect foresight."@en ;
    bsm:symbol "pf_vaf" ;
    bsm:formula "beta*L*G**(1 - rho)" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:inHARK "PFVAFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pffvac> .

bsm:BSM_0000077
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "value-of-autarky factor"@en ;
    skos:notation "value-of-autarky-factor" ;
    skos:definition "β̊ 𝒢^(1−ϱ) E[ψ^(1−ϱ)], the factor of the value of consuming permanent income forever."@en ;
    bsm:symbol "vaf" ;
    bsm:formula "beta*L*G**(1 - rho)*E_psi_1mrho" ;
    bsm:dependsOn bsm:BSM_0000063 ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:inHARK "VAFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000078
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "weak return patience factor"@en ;
    skos:notation "weak-return-patience-factor" ;
    skos:definition "p_worst^(1/ϱ) Þ̊_R, the return patience factor scaled by the probability of the worst income."@en ;
    bsm:symbol "wrp" ;
    bsm:formula "p_worst**(1/rho)*thorn_R" ;
    bsm:dependsOn bsm:BSM_0000049 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inHARK "WRPFac" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000079
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "limiting MPC as resources grow"@en ;
    skos:notation "mpc-min" ;
    skos:definition "κ_min = max(0, 1 − Þ̊_R), the limit of the MPC as m → ∞."@en ;
    bsm:symbol "mpc_min" ;
    bsm:formula "max([0, 1 - thorn_R])" ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inBST "\\MPCmin" ;
    bsm:registryKey "mpc-min" ;
    bsm:inHARK "MPCmin" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#mpcmindefn> .

bsm:BSM_0000080
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "limiting MPC as resources fall to their lowest"@en ;
    skos:notation "mpc-max" ;
    skos:definition "κ_max = 1 − p_worst^(1/ϱ) Þ̊_R, the limit of the MPC as m falls to its lowest value."@en ;
    bsm:symbol "mpc_max" ;
    bsm:formula "1 - p_worst**(1/rho)*thorn_R" ;
    bsm:dependsOn bsm:BSM_0000049 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inBST "\\MPCmax" ;
    bsm:registryKey "mpc-max" ;
    bsm:inHARK "MPCmax" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mpcmaxdefn> .

bsm:BSM_0000081
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "natural borrowing limit, computed"@en ;
    skos:notation "natural-limit" ;
    skos:definition "The value of a_Nat: −ξ_min ψ_min/(ℛ − ψ_min), which is zero when the worst transitory income is zero or the permanent shock's law is unbounded below."@en ;
    bsm:symbol "a_Nat_value" ;
    bsm:formula "-xi_min*psi_min/(R/G - psi_min)" ;
    bsm:note "when ψ_min < ℛ; otherwise there is no natural limit" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000046 ;
    bsm:dependsOn bsm:BSM_0000047 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000082
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "absolute impatience"@en ;
    skos:notation "aic" ;
    bsm:holdsWhen "thorn < 1" ;
    bsm:shortName "AIC" ;
    bsm:hasFactor bsm:BSM_0000068 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    bsm:inHARK "check_AIC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#aic> .

bsm:BSM_0000083
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "return impatience"@en ;
    skos:notation "ric" ;
    bsm:holdsWhen "thorn_R < 1" ;
    bsm:shortName "RIC" ;
    bsm:hasFactor bsm:BSM_0000069 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inHARK "check_RIC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ric> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-ric> .

bsm:BSM_0000084
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "weak return impatience"@en ;
    skos:notation "wric" ;
    bsm:holdsWhen "wrp < 1" ;
    bsm:shortName "WRIC" ;
    bsm:hasFactor bsm:BSM_0000078 ;
    bsm:dependsOn bsm:BSM_0000078 ;
    bsm:inHARK "check_WRIC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000085
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "finite human wealth"@en ;
    skos:notation "fhwc" ;
    bsm:holdsWhen "fhw < 1" ;
    bsm:shortName "FHWC" ;
    bsm:hasFactor bsm:BSM_0000074 ;
    bsm:dependsOn bsm:BSM_0000074 ;
    bsm:inHARK "check_FHWC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-fhwc> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-fhwc2> .

bsm:BSM_0000086
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "perfect-foresight finite value of autarky"@en ;
    skos:notation "pf-fvac" ;
    bsm:holdsWhen "pf_vaf < 1" ;
    bsm:shortName "PF-FVAC" ;
    bsm:hasFactor bsm:BSM_0000076 ;
    bsm:dependsOn bsm:BSM_0000076 ;
    bsm:inHARK "PerfForesightConsumerType.check_FVAC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pffvac> .

bsm:BSM_0000087
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "finite value of autarky"@en ;
    skos:notation "fvac" ;
    bsm:holdsWhen "vaf < 1" ;
    bsm:shortName "FVAC" ;
    bsm:hasFactor bsm:BSM_0000077 ;
    bsm:dependsOn bsm:BSM_0000077 ;
    bsm:inHARK "IndShockConsumerType.check_FVAC" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000088
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "growth impatience"@en ;
    skos:notation "gic" ;
    bsm:holdsWhen "thorn_G < 1" ;
    bsm:shortName "GIC" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:inHARK "check_GICRaw" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicraw> .

bsm:BSM_0000089
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "strong growth impatience"@en ;
    skos:notation "gic-mod" ;
    bsm:holdsWhen "thorn_G_mod < 1" ;
    bsm:shortName "GIC-Mod" ;
    bsm:hasFactor bsm:BSM_0000071 ;
    bsm:dependsOn bsm:BSM_0000071 ;
    bsm:inHARK "check_GICMod" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicmod> .

bsm:BSM_0000090
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "log growth impatience"@en ;
    skos:notation "gic-szeidl" ;
    bsm:holdsWhen "log(thorn_G) < E_log_psi" ;
    bsm:shortName "GIC-Szeidl" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000064 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:inHARK "check_GICSdl" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000091
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "Harmenberg growth impatience"@en ;
    skos:notation "gic-harmenberg" ;
    bsm:holdsWhen "thorn_G < exp(E_psi_log_psi)" ;
    bsm:shortName "GIC-Harmenberg" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000065 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:inHARK "check_GICHrm" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> .

bsm:BSM_0000092
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "mortality-adjusted growth impatience"@en ;
    skos:notation "gic-liv" ;
    skos:note "The paper writes ℒ Þ_𝒢 < 1 without saying whether Þ carries survival. The owner ruled on 2026-10-22, in econ-ark's notation registry, that the condition is ℒ Þ̊_𝒢 < 1, HARK's GPFacLiv: a survivor discounts by βℒ, so its wealth grows at Þ̊, and the cohort shrinks at ℒ. It assumes, as the paper does, that newborns' permanent income grows with aggregate productivity."@en ;
    bsm:holdsWhen "thorn_G_liv < 1" ;
    bsm:shortName "GIC-Liv" ;
    bsm:hasFactor bsm:BSM_0000072 ;
    bsm:dependsOn bsm:BSM_0000072 ;
    bsm:inHARK "check_GICLiv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000093
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a non-degenerate limiting solution"@en ;
    skos:notation "nondegenerate-limiting-solution" ;
    skos:definition "The finite-horizon consumption and value functions converge, as the horizon recedes, to a consumption function that is positive and finite for every m > 0 and a real-valued value function."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000094
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "consumption growth below one as resources grow"@en ;
    skos:notation "consumption-falls-at-high-wealth" ;
    skos:definition "As m → ∞, the growth factor of consumption approaches the absolute patience factor, which is below one."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#aic> .

bsm:BSM_0000095
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a positive MPC as resources grow"@en ;
    skos:notation "positive-limiting-mpc" ;
    skos:definition "The MPC of the limiting consumption function tends to 1 − Þ̊_R > 0 as m → ∞."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#lemma-mpcboundsconvg> .

bsm:BSM_0000096
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "finite human wealth"@en ;
    skos:notation "finite-human-wealth" ;
    skos:definition "The present value of noncapital income is finite in the limit of an infinite horizon."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-hdef> .

bsm:BSM_0000097
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an individual buffer-stock target"@en ;
    skos:notation "target-exists" ;
    skos:definition "There is a unique m̂ > 0 with E_t[m_{t+1}] = m_t at m_t = m̂, below which expected m rises and above which it falls."@en ;
    bsm:symbol "m̂" ;
    bsm:inBST "\\mTrgNrm" ;
    bsm:registryKey "target" ;
    bsm:inHARK "mNrmTrg" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-target> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mtarget> .

bsm:BSM_0000098
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a pseudo-target"@en ;
    skos:notation "pseudo-target-exists" ;
    skos:definition "There is a unique m̌ > 0 at which the expected growth factor of the level of market resources equals 𝒢, below which it is higher and above which it is lower."@en ;
    bsm:symbol "m̌" ;
    bsm:inBST "\\mBalLvl" ;
    bsm:registryKey "pseudo-target" ;
    bsm:inHARK "mNrmStE" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-mssbalexists> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mballvl> .

bsm:BSM_0000099
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a log target"@en ;
    skos:notation "log-target-exists" ;
    skos:definition "There is an m̃ at which E_t[log 𝐦_{t+1}] = log 𝒢 𝐦_t; the paper states its existence under log growth impatience in a footnote, without proof."@en ;
    bsm:symbol "m̃" ;
    bsm:inBST "\\mBalLog" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#collective-stability> .

bsm:BSM_0000100
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an invariant distribution under the population measure"@en ;
    skos:notation "invariant-population-distribution" ;
    skos:definition "A population following the limiting rule has invariant distributions of m, c and a, each agent weighted equally."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000101
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an invariant distribution under the income measure"@en ;
    skos:notation "invariant-income-distribution" ;
    skos:definition "A population following the limiting rule has invariant distributions of m and c weighted by permanent income."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-harmcdf> .

bsm:BSM_0000102
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "aggregate balanced growth"@en ;
    skos:notation "aggregate-balanced-growth" ;
    skos:definition "Aggregate consumption, market resources and assets grow in the long run at the growth factor of aggregate permanent income."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-cgroeqpermgrofacq> .

bsm:BSM_0000103
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "the artificial constraint is relevant"@en ;
    skos:notation "constraint-relevant" ;
    skos:definition "Under perfect foresight, a constraint a ≥ 0 binds at some m."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-liqconstrbinds> .

bsm:BSM_0000104
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "buffer-stock saving"@en ;
    skos:notation "buffer-stock-saving" ;
    skos:definition "A member exhibits buffer-stock saving when it has a non-degenerate limiting solution and an individual buffer-stock target. This draft takes the individual target, as the paper's introduction does; whether the pseudo-target suffices is left to the owner."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#patience-requirements-and-the-existence-of-buffer-stock-targets> .

bsm:BSM_0000105
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "existence of a non-degenerate solution"@en ;
    skos:notation "existence" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sufficient-conditions-for-non-degenerate-solution> .

bsm:BSM_0000106
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "contraction under consumption bounds"@en ;
    skos:notation "contraction" ;
    skos:note "The MPC-bounded Bellman operator is eventually a contraction on a weighted-norm space."@en ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-cmap> .

bsm:BSM_0000107
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the limiting MPCs"@en ;
    skos:notation "limiting-mpcs" ;
    skos:note "The maximal MPC converges to κ_max > 0; under the RIC the minimal MPC converges to 1 − Þ_R > 0."@en ;
    bsm:status "bst" ;
    bsm:resultKind "lemma" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#limiting-mpcs> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cfuncbounds> .

bsm:BSM_0000108
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the limiting rule's MPC bounds"@en ;
    skos:notation "mpc-bounds-of-the-limit" ;
    bsm:status "bst" ;
    bsm:resultKind "lemma" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000095 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#lemma-mpcboundsconvg> .

bsm:BSM_0000109
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the buffer-stock target"@en ;
    skos:notation "target" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000089 ;
    bsm:concludes bsm:BSM_0000097 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-target> .

bsm:BSM_0000110
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the pseudo-target"@en ;
    skos:notation "pseudo-target" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000098 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-mssbalexists> .

bsm:BSM_0000111
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the log target"@en ;
    skos:notation "log-target" ;
    skos:note "Stated in a footnote, without proof; the three points are ordered m̌ < m̃ < m̂ where they exist."@en ;
    bsm:status "stated" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000099 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#collective-stability> .

bsm:BSM_0000112
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "Szeidl's invariance theorem"@en ;
    skos:notation "szeidl" ;
    bsm:status "cited" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000100 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000113
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "Harmenberg's invariance theorem"@en ;
    skos:notation "harmenberg" ;
    bsm:status "cited" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000101 ;
    bsm:concludes bsm:BSM_0000102 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> .

bsm:BSM_0000114
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "balanced growth with estates destroyed"@en ;
    skos:notation "mortality-balanced-growth" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000004 ;
    bsm:assumes bsm:BSM_0000092 ;
    bsm:concludes bsm:BSM_0000102 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000115
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the unconstrained perfect-foresight solution"@en ;
    skos:notation "pf-unconstrained" ;
    skos:note "If and only if."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000003 ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfucfhwc> .

bsm:BSM_0000116
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained perfect-foresight solution"@en ;
    skos:notation "pf-constrained" ;
    skos:note "With a constraint a ≥ 0; when the RIC fails, a non-degenerate solution exists if and only if the GIC holds."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000003 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000117
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "when the constraint binds under perfect foresight"@en ;
    skos:notation "pf-constraint-relevance" ;
    skos:note "If and only if."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000003 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000103 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-liqconstrbinds> .

bsm:BSM_0000118
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained solution as a limit"@en ;
    skos:notation "liquidity-constrained-limit" ;
    skos:note "As ℘ → 0, the solution with the zero-income event converges to the solution with ℘ = 0 and the artificial constraint a ≥ 0."@en ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-liqconstraslimit> .

bsm:BSM_0000119
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "return and growth patience together rule out a finite value of autarky"@en ;
    skos:notation "no-ric-no-gic" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:assumesFailureOf bsm:BSM_0000088 ;
    bsm:concludesFailureOf bsm:BSM_0000087 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> .

bsm:BSM_0000120
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience and finite human wealth give the perfect-foresight finite value of autarky"@en ;
    skos:notation "pf-gic-implies-pf-fvac" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000086 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-pfconspc> .

bsm:BSM_0000121
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the perfect-foresight finite value of autarky and finite human wealth give return impatience"@en ;
    skos:notation "pf-fvac-implies-ric" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000086 ;
    bsm:concludes bsm:BSM_0000083 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-pfconspc> .

bsm:BSM_0000122
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience without return impatience means infinite human wealth"@en ;
    skos:notation "gic-without-ric" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:concludesFailureOf bsm:BSM_0000085 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000123
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the finite value of autarky implies its perfect-foresight version"@en ;
    skos:notation "fvac-implies-pf-fvac" ;
    skos:note "Jensen's inequality, with ϱ > 1 and E[ψ] = 1, gives E[ψ^(1−ϱ)] ≥ 1."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:concludes bsm:BSM_0000086 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> .

bsm:BSM_0000124
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "return impatience implies weak return impatience"@en ;
    skos:notation "ric-implies-wric" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000084 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000125
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "strong growth impatience implies log growth impatience"@en ;
    skos:notation "gic-mod-implies-gic-szeidl" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000089 ;
    bsm:concludes bsm:BSM_0000090 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000126
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "log growth impatience implies growth impatience"@en ;
    skos:notation "gic-szeidl-implies-gic" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000088 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000127
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience implies Harmenberg's condition"@en ;
    skos:notation "gic-implies-gic-harmenberg" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000091 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-gicimpliesharmimp> .

bsm:BSM_0000128
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience implies its mortality-adjusted version"@en ;
    skos:notation "gic-implies-gic-liv" ;
    skos:note "The mortality-adjusted condition is looser, since ℒ ≤ 1."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000092 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000153
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "with a finite value of autarky, return patience means infinite human wealth"@en ;
    skos:notation "fvac-without-ric" ;
    skos:note "From no-ric-no-gic, the FVAC with the RIC failing gives the GIC; from gic-without-ric, the GIC with the RIC failing gives infinite human wealth. Uses ϱ > 1."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:concludesFailureOf bsm:BSM_0000085 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000129
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the problem in levels and in ratios"@en ;
    skos:notation "levels-and-ratios" ;
    skos:definition "The problem in levels, in (𝐦, 𝐩), and the normalized problem, in m = 𝐦/𝐩, are one model: 𝐜(𝐦, 𝐩) = 𝐩 c(𝐦/𝐩) and 𝐯(𝐦, 𝐩) = 𝐩^(1−ϱ) v(𝐦/𝐩)."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-ratio> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-recoverlevels> .

bsm:BSM_0000130
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the limiting solution and the stationary fixed point"@en ;
    skos:notation "limit-and-fixed-point" ;
    skos:definition "A non-degenerate limiting solution, the limit of the finite-horizon solutions, is a fixed point of the stationary Bellman operator, and so the solution of the infinite-horizon problem."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-theory> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-stationarybellman> .

bsm:BSM_0000131
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the decision problem depends on β and ℒ through β̊"@en ;
    skos:notation "decision-problem-through-beta-eff" ;
    skos:definition "Without an annuity, the household's problem, and so its rule, depends on β and ℒ only through β̊ = β ℒ; the population does not, since ℒ also sets the rate of death and replacement. Two members with the same β̊ and different ℒ have one rule and two populations. Where survival depends on the current Markov state s, as HARK's Markov solver allows, the rule depends on them only through β ℒ(s), state by state. With Blanchard's annuity, as in HARK's AggShockConsumerType, ℒ also enters the return R/ℒ that the budget carries, and the identity fails."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L376> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsMarkovModel.py#L429> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsMarkovModel.py#L583-L588> .

bsm:BSM_0000132
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "an artificial constraint no tighter than the natural one"@en ;
    skos:notation "loose-artificial-constraint" ;
    skos:definition "A model with a_Art ≤ a_Nat is the model without an artificial constraint: the natural constraint is in force, and a looser one never binds."@en ;
    bsm:identityKind "reduction" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000133
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "a benefit with no unemployment"@en ;
    skos:notation "unemployment-benefit-without-unemployment" ;
    skos:definition "With ℘ = 0, ξ_u never pays, and models differing only in ξ_u are one model."@en ;
    bsm:identityKind "reduction" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000134
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "two written laws of one shock"@en ;
    skos:notation "same-laws" ;
    skos:definition "Two written laws of a shock are the same law when the ontology of probability distributions' identity rule says so; two models differing only in the spelling of their laws are one model."@en ;
    bsm:identityKind "equivalence" .

bsm:BSM_0000135
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "Blanchard's annuity leaves patience unchanged"@en ;
    skos:notation "blanchard-patience" ;
    skos:definition "With Blanchard's annuity, β̊ R/ℒ = β R, so the absolute patience factor is the one with infinite lives; only the quantities in which R enters apart from Þ change, the return patience factor becoming Þ/(R/ℒ)."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000136
    a owl:NamedIndividual, bsm:Family ;
    rdfs:label "the schemas' family bst/1"@en ;
    skos:notation "bst-1" ;
    skos:definition "The working group's written family bst/1: its parameter file and its stage file write buffer-stock models with perpetual youth and no annuity, a benefit ξ_u ≥ 0, an artificial constraint at or above the natural one, and permanent types differing in β, with mean-one laws of ψ and θ from the ontology of probability distributions."@en ;
    bsm:schemaDocument "../../schemas/bst-1/model.md" ;
    bsm:writes bsm:BSM_0000004 ;
    bsm:writes bsm:BSM_0000006 ;
    bsm:writes bsm:BSM_0000007 ;
    bsm:writes bsm:BSM_0000008 .

bsm:BSM_0000137
    a owl:NamedIndividual, bsm:Family ;
    rdfs:label "the schemas' family bst-markov_ui-and-agg/1"@en ;
    skos:notation "bst-markov-ui-and-agg-1" ;
    skos:definition "The working group's written family for HAFiscal's household: bst/1 with Markov employment and benefit expiry, an aggregate regime, groups of types, a level law for the newborn and the splurge as an observation map."@en ;
    bsm:schemaDocument "../../schemas/bst-markov_ui-and-agg/model.md" ;
    bsm:writes bsm:BSM_0000004 ;
    bsm:writes bsm:BSM_0000006 ;
    bsm:writes bsm:BSM_0000007 ;
    bsm:writes bsm:BSM_0000008 ;
    bsm:writes bsm:BSM_0000009 .

bsm:BSM_0000138
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-vafac-without-survival"@en ;
    skos:notation "hark-vafac-without-survival" ;
    skos:definition "HARK's VAFac leaves out the survival probability ℒ that β̊ carries; draft pull request econ-ark/HARK#1855 adds it."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000077 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2553> .

bsm:BSM_0000139
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-gpfaclivmod-survival-twice"@en ;
    skos:notation "hark-gpfaclivmod-survival-twice" ;
    skos:definition "HARK has two mortality-adjusted factors. GPFacLiv, ℒ times GPFacRaw, with ℒ already in APFac, is ℒ Þ̊_𝒢, the GIC-Liv as the owner ruled it on 2026-10-22, and HARK's check_GICLiv uses it. GPFacLivMod, named for the Modigliani scheme, multiplies by ℒ again; no HARK check uses it."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000072 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2542-L2543> .

bsm:BSM_0000140
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-no-log-target"@en ;
    skos:notation "hark-no-log-target" ;
    skos:definition "The paper says Econ-ARK computes the log target m̃ as mBalLog; HARK's main branch computes no such value."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000099 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#collective-stability> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L1975-L1998> .

bsm:BSM_0000141
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-xi-is-theta"@en ;
    skos:notation "hafiscal-xi-is-theta" ;
    skos:definition "The published HAFiscal paper writes ξ for the employed transitory shock, which is BST's θ; BST's ξ is transitory income with the unemployment event included."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:concerns bsm:BSM_0000034 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Model.tex#L129> .

bsm:BSM_0000142
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-target-is-a-moment"@en ;
    skos:notation "hafiscal-target-is-a-moment" ;
    skos:definition "In the HAFiscal paper and code a \"target\" is mostly an estimation target, a data moment matched, not BST's target ratio of market resources."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:concerns bsm:BSM_0000097 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L20-L23> .

bsm:BSM_0000143
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-mpc-is-a-lottery-mpc"@en ;
    skos:notation "hafiscal-mpc-is-a-lottery-mpc" ;
    skos:definition "HAFiscal's MPC is the share of a windfall spent over the following four quarters, not the derivative c′(m) whose limits this ontology names."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:concerns bsm:BSM_0000079 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L20> .

bsm:BSM_0000144
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "natural-limit-from-atoms"@en ;
    skos:notation "natural-limit-from-atoms" ;
    skos:definition "HARK's classic solvers compute the natural limit from the lowest atoms of the discretized laws; the paper and this ontology take it from the true laws' infima. HARK's draft pull request econ-ark/HARK#1862 computes it from the infima."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000057 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L493> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L511> .

bsm:BSM_0000152
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-gic-cap"@en ;
    skos:notation "hafiscal-gic-cap" ;
    skos:definition "HAFiscal's code caps each type's discount factor so that ℒ (Rβ)^(1/ϱ) E[ψ⁻¹]/𝒢, which its comments call the growth patience factor and the GIC-Mod with survival, is at most a margin below one. Survival there multiplies the patience factor without entering it. This ontology's GIC-Mod is Þ̊_𝒢 E[ψ⁻¹] with Þ̊ = (Rβℒ)^(1/ϱ), and HARK's GPFacLiv is ℒ Þ̊_𝒢: three placements of ℒ in one condition. The cap replaced an earlier (1 − ℒ) + 𝒢^ϱ/R."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:concerns bsm:BSM_0000088 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Code/HA-Models/FromPandemicCode/EstimParameters.py#L398-L418> ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Code/HA-Models/FromPandemicCode/EstimParameters.py#L430-L437> .

bsm:BSM_0000154
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-pffvac-message"@en ;
    skos:notation "hark-pffvac-message" ;
    skos:definition "HARK's perfect-foresight value-of-autarky factor is computed as β ℒ 𝒢^(1−ϱ), with survival, but its message states the condition as β𝒢^(1−ϱ) < 1; its risk-modified VAFac leaves survival out."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000086 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L1796> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L1716-L1719> .

bsm:BSM_0000155
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-wric-message"@en ;
    skos:notation "hark-wric-message" ;
    skos:definition "HARK computes the weak return patience factor as p_worst^(1/ϱ) Þ/R, as the paper states it, but its message writes the condition as ℘ Þ/R < 1, without the power 1/ϱ."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000084 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2581> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2697-L2700> .

bsm:BSM_0000156
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-worst-income-prob-from-atoms"@en ;
    skos:notation "hark-worst-income-prob-from-atoms" ;
    skos:definition "HARK's WorstPrb is the probability of the smallest product of the discretized laws' atoms. It is the paper's ℘ when the unemployment event pays nothing; with a positive benefit and a continuous permanent shock it is ℘ divided by the number of permanent-shock atoms, where the true law gives zero."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000049 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2570-L2578> .

bsm:BSM_0000157
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-two-human-wealths"@en ;
    skos:notation "hark-two-human-wealths" ;
    skos:definition "HARK names two objects hNrm. The one its condition report computes includes this period's income, the paper's h; the one each period's solution carries excludes it, so its limit is h − 1."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000075 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2585> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L296> .

bsm:BSM_0000158
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-ric-failure-message"@en ;
    skos:notation "hark-ric-failure-message" ;
    skos:definition "When the RIC fails, HARK's consumer with shocks reports that the FHWC fails too. Within the class, where ϱ > 1, that follows only when the FVAC holds: with Jensen's inequality the FVAC gives β̊ < 𝒢^(ϱ−1), the failing RIC gives β̊ ≥ R^(ϱ−1), and so R < 𝒢. HARK prints it unconditionally, and also for ϱ < 1, outside the class, where even the FVAC does not make it true. It also calls the consumer impatient where its perfect-foresight report calls the same failure patience."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000153 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2769> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L1897> .

bsm:BSM_0000159
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hark-cyclical-index-solver-and-simulation"@en ;
    skos:notation "hark-cyclical-index-solver-and-simulation" ;
    skos:definition "In every HARK model the solution for period t takes the expectation over the shocks of the move from t to t+1, with the rule of period t+1. What differs is which entry of the time-varying parameter lists holds that move's laws. A life-cycle model's solver passes entry t, so entry k is the move out of k. A cyclical model's (cycles = 0 with several periods in the cycle, or cycles > 1) passes entry t+1, so entry k is the move into k. The simulation reads entry s − 1 on the move into period s for every value of cycles: the income shocks, growth and the return. Where parameters vary within a cycle, they reach the simulation of a cyclical model a period after its solution expected them; HARK's four-period example has such growth. The cyclical order came with HARK's commit 54083db5 of 2021-07-09 (issue econ-ark/HARK#1022, pull request #1039), whose title gives its aim as entries that correspond to t. That commit moved the simulation of death to match and rotated the example's growth by one, so the example's solution stayed the same. It left the simulation's shocks, growth and return reading entry s − 1, and so moved the example's simulated growth by a period. The Markov consumer's simulation of death reads entry s − 1 for every value of cycles. Which convention HARK should follow is not settled."@en ;
    bsm:where "hark" ;
    bsm:concerns bsm:BSM_0000025 ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L650-L662> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/core.py#L2457> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L2275-L2277> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L1531-L1533> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsIndShockModel.py#L3143-L3145> ;
    dcterms:source <https://github.com/econ-ark/HARK/blob/4c285e86/HARK/ConsumptionSaving/ConsMarkovModel.py#L987-L989> .
